{
  "name": "@mz/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Market Zero design tokens — single source of truth for color, type, spacing, motion.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens.json": "./src/tokens.json",
    "./tokens.css": "./src/tokens.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit && node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for design-tokens yet'",
    "test": "echo 'no tests yet'",
    "clean": "rimraf .turbo dist *.tsbuildinfo"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3"
  }
}
