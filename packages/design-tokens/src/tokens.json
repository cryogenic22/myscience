{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Market Zero",
    "version": "0.1.0",
    "description": "Single source of truth for color, type, spacing, radius, motion, and shadow."
  },

  "color": {
    "neutral": {
      "light": {
        "canvas":         "#FAFAF7",
        "surface":        "#FFFFFF",
        "elevated":       "#F5F4F0",
        "border-subtle":  "#ECECE7",
        "border-strong":  "#D6D5CE",
        "text-primary":   "#18191B",
        "text-secondary": "#565759",
        "text-tertiary":  "#8C8E91",
        "text-inverse":   "#FAFAF7"
      },
      "dark": {
        "canvas":         "#0E0F11",
        "surface":        "#14161A",
        "elevated":       "#1A1D22",
        "border-subtle":  "#21252B",
        "border-strong":  "#2A2F36",
        "text-primary":   "#E7E9EC",
        "text-secondary": "#98A0AA",
        "text-tertiary":  "#5E6670",
        "text-inverse":   "#14161A"
      }
    },

    "accent": {
      "research": {
        "light": "#C97A3A",
        "dark":  "#E29964"
      },
      "ci": {
        "light": "#2F6BFF",
        "dark":  "#5C8CFF"
      },
      "regulatory": {
        "light": "#1E8A7E",
        "dark":  "#2BA295"
      }
    },

    "semantic": {
      "success": { "light": "#2E8B57", "dark": "#4CAF7A" },
      "warning": { "light": "#B7791F", "dark": "#E0A14C" },
      "danger":  { "light": "#B0301C", "dark": "#E06B57" },
      "info":    { "light": "#2F6BFF", "dark": "#5C8CFF" }
    },

    "tier": {
      "confidence": {
        "confirmed": { "ref": "color.semantic.success" },
        "reported":  { "ref": "color.neutral.text-secondary" },
        "inferred":  { "ref": "color.semantic.warning" },
        "disputed":  { "ref": "color.semantic.danger" }
      },
      "impact": {
        "high":   { "ref": "color.semantic.danger" },
        "medium": { "ref": "color.semantic.warning" },
        "low":    { "ref": "color.neutral.text-tertiary" }
      }
    }
  },

  "typography": {
    "family": {
      "sans":    "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "display": "'Inter Display', Inter, system-ui, sans-serif",
      "mono":    "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "display-1":   "36px",
      "display-2":   "28px",
      "display-3":   "24px",
      "headline-1":  "20px",
      "headline-2":  "18px",
      "headline-3":  "16px",
      "body-1":      "15px",
      "body-2":      "14px",
      "body-3":      "13px",
      "mono-1":      "13px",
      "mono-2":      "12px",
      "mono-3":      "11px"
    },
    "weight": {
      "regular":  "400",
      "medium":   "500",
      "semibold": "600",
      "bold":     "700"
    },
    "lineHeight": {
      "tight":   "1.2",
      "normal":  "1.5",
      "relaxed": "1.7"
    },
    "letterSpacing": {
      "tight":  "-0.02em",
      "normal": "0",
      "wide":   "0.05em"
    }
  },

  "space": {
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "6":  "24px",
    "8":  "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },

  "radius": {
    "control":  "6px",
    "card":     "10px",
    "elevated": "14px",
    "pill":     "999px"
  },

  "motion": {
    "duration": {
      "fast":   "120ms",
      "medium": "200ms",
      "slow":   "320ms"
    },
    "easing": {
      "spring":   "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(24, 25, 27, 0.06)",
      "md": "0 4px 12px rgba(24, 25, 27, 0.08)",
      "lg": "0 12px 32px rgba(24, 25, 27, 0.12)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "md": "0 4px 12px rgba(0, 0, 0, 0.5)",
      "lg": "0 12px 32px rgba(0, 0, 0, 0.6)"
    }
  },

  "density": {
    "compact":     { "rowHeight": "32px", "padding": "8px 12px",  "gap": "4px"  },
    "comfortable": { "rowHeight": "40px", "padding": "12px 16px", "gap": "8px"  },
    "spacious":    { "rowHeight": "52px", "padding": "16px 20px", "gap": "12px" }
  }
}
