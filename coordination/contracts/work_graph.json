      "spec": {
        "path": "specs/governance/TIV2_COORDINATION_KERNEL.md",
        "acceptance": {
          "CK#1": {
            "statement": "Unknown dependencies, cycles, duplicate work IDs, duplicate migration reservations, invalid paths, and undeclared lanes fail closed.",
            "verification": ["test:tests/test_coordination_kernel.py"]
          },
          "CK#2": {
            "statement": "Lane capacity and overlapping active path claims are rejected by the contract validator; Phase 1 exposes no work-selection API.",
            "verification": ["test:tests/test_coordination_kernel.py"]
          },
          "CK#3": {
            "statement": "Lifecycle evidence is strictly typed and its internal predicate requires base-to-distinct-RED-to-head ancestry plus non-vacuous RED and exact-head GREEN; Phase 1 cannot make a live readiness decision.",
            "verification": ["test:tests/test_coordination_kernel.py"]
          },
          "CK#4": {
            "statement": "Required-check, review, merge, and observation evidence is internally checked for exact-head and temporal consistency, but all live and terminal state input is rejected until an external adapter can bind repository, ref, commit, canonical graph digest, and event provenance.",
            "verification": ["test:tests/test_coordination_kernel.py"]
          },
          "CK#5": {
            "statement": "Protected paths require an owner decision and exact-file authorization; wildcard authorization is rejected.",
            "verification": ["test:tests/test_coordination_kernel.py", "test:tests/test_protected_surface_sync.py"]
          },
          "CK#6": {
            "statement": "Missing, malformed, duplicate-key, non-standard, stale, unlinked, zero-case, out-of-scope, acceptance-drift, repository-unbound, or undeclared verifier evidence fails closed; CI derives tests only from executable protected contracts; Phase 1 exports no state, readiness, review, or queue API.",
            "verification": ["test:tests/test_coordination_kernel.py", "test:tests/test_coordination_cli.py"]
          }
        }
      },
